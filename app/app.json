      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2c7a4b"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c6bfbe3-0ccb-47ab-a2e0-e811afbdc450"
      }
    },
    "icon": "./assets/icon.png"
  }
}
