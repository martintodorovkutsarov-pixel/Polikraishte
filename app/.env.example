# Copy this file to .env and fill in your Supabase project's values
# (Dashboard -> Project Settings -> API). Expo automatically loads any
# variable prefixed with EXPO_PUBLIC_ and makes it available in app code
# via process.env — no extra setup needed.
#
# It's safe for the anon key to ship inside the app; row-level security
# policies (see supabase/schema.sql) control what it's allowed to do.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
